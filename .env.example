# --- Site -------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Supabase (leave empty to run in demo mode: no accounts, everything stays on the device) ---
# Project Settings -> API in the Supabase dashboard (or `npx supabase status` for a local stack).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Encryption of diary entries and test answers (server only, required with Supabase) ---
# Generate:  node -e "console.log('v1:'+require('crypto').randomBytes(32).toString('base64'))"
# Keep it secret and back it up: without it encrypted records cannot be read.
APP_ENCRYPTION_KEYS=

# --- Optional: cookie-free analytics (Plausible / Umami) -------------------------------------
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_DOMAIN=
